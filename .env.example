# ---- HSR Club Dine — backend settings ----
# Copy to ".env" and fill in. Everything here has a working default for local
# dev, so the app runs out of the box with zero configuration.

APP_NAME="HSR Club Dine"
ENVIRONMENT=local
LOG_LEVEL=INFO

# CORS: "*" for local dev, or a comma-separated allowlist in production, e.g.
#   CORS_ORIGINS="https://dine.hsrclub.in"
CORS_ORIGINS=*

# Storage backend: "file" (durable, default) | "memory" (ephemeral).
DB_BACKEND=file
DATA_DIR=./data

# ---- Customer + admin auth (HS256 JWTs this API issues) ----
JWT_SECRET=dev-secret-change-me
JWT_EXPIRE_MINUTES=720
# Staff/admin dashboard password. Change this for any real deployment.
ADMIN_PASSWORD=hsrclub-admin

# Rate limits (per client IP + target, sliding window). Defaults are sensible;
# tune if needed. In production the app refuses to boot with the insecure
# JWT_SECRET / ADMIN_PASSWORD defaults or CORS_ORIGINS='*'.
OTP_REQUEST_RATE_LIMIT=5
OTP_REQUEST_WINDOW_SECONDS=600
OTP_VERIFY_RATE_LIMIT=10
OTP_VERIFY_WINDOW_SECONDS=600
ADMIN_LOGIN_RATE_LIMIT=8
ADMIN_LOGIN_WINDOW_SECONDS=300

# ---- Phone OTP ----
# Demo mode (default): the OTP is logged and returned in the API response so the
# flow is fully testable without an SMS provider. Set OTP_DEMO_MODE=false and
# configure a provider below to send real SMS.
OTP_DEMO_MODE=true
OTP_LENGTH=6
OTP_TTL_SECONDS=300

# Which provider to use when OTP_DEMO_MODE=false: "msg91" (India) or "twilio".
# If the chosen provider's credentials are missing, the app falls back to demo
# mode (and logs a warning) rather than failing to send.
OTP_PROVIDER=msg91

# Twilio (global) — https://www.twilio.com/console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=        # E.164, e.g. +15551234567

# MSG91 (India, cheaper for Indian numbers) — https://control.msg91.com
# Create a DLT-approved Flow template with one variable for the code; put its
# variable name in MSG91_OTP_VAR (default "otp").
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=
MSG91_OTP_VAR=otp

# ---- Razorpay (cards + UPI: GPay / PhonePe / Paytm / netbanking) ----
# Leave blank to run the built-in DEMO gateway (the checkout flow completes and
# records a paid order without moving real money — great for local testing).
# Add your TEST keys from https://dashboard.razorpay.com to run real Razorpay
# Checkout in test mode; swap in LIVE keys after KYC to take real payments.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Currency for charges (Razorpay uses the smallest unit, i.e. paise for INR).
CURRENCY=INR
# Razorpay webhook secret (Dashboard → Settings → Webhooks). When set, the
# /payments/razorpay/webhook endpoint verifies events and marks orders paid
# server-to-server — reliable even if the customer's browser drops off.
RAZORPAY_WEBHOOK_SECRET=

# ---- Order notifications (SMS / WhatsApp to the diner) ----
# Best-effort messages when an order is placed and when it's served. Reuses your
# Twilio credentials above. Set NOTIFY_CHANNEL=whatsapp and a WhatsApp-enabled
# Twilio sender to message over WhatsApp instead of SMS. Never blocks an order.
ORDER_NOTIFICATIONS_ENABLED=false
NOTIFY_CHANNEL=sms
TWILIO_WHATSAPP_FROM=          # e.g. whatsapp:+14155238886

# ---- Multi-language menu ----
# The default language plus any others diners can switch to (comma-separated
# ISO codes). Items carry per-language overrides in their `translations` map.
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,hi,kn

# ---- Production guard ----
# When ENVIRONMENT=prod the app refuses to boot if: JWT_SECRET / ADMIN_PASSWORD
# are still defaults, CORS_ORIGINS='*', OTP_DEMO_MODE=true, or Razorpay is
# unconfigured. In other words, no demo OTP and no demo payments in production.
