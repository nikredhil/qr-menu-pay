# ---- HSR Club Dine — backend settings ----
# Copy to ".env" and fill in. Everything here has a working default for local
# dev, so the app runs out of the box with zero configuration.

APP_NAME="HSR Club Dine"
ENVIRONMENT=local
LOG_LEVEL=INFO

# CORS: "*" for local dev, or a comma-separated allowlist in production, e.g.
#   CORS_ORIGINS="https://dine.hsrclub.in"
CORS_ORIGINS=*

# Storage backend: "file" (durable, default) | "memory" (ephemeral).
DB_BACKEND=file
DATA_DIR=./data

# ---- Customer + admin auth (HS256 JWTs this API issues) ----
JWT_SECRET=dev-secret-change-me
JWT_EXPIRE_MINUTES=720
# Staff/admin dashboard password. Change this for any real deployment.
ADMIN_PASSWORD=hsrclub-admin

# ---- Phone OTP ----
# Demo mode (default): the OTP is logged and returned in the API response so the
# flow is fully testable without an SMS provider. Set OTP_DEMO_MODE=false and add
# a provider (Twilio/MSG91) to send real SMS.
OTP_DEMO_MODE=true
OTP_LENGTH=6
OTP_TTL_SECONDS=300

# ---- Razorpay (cards + UPI: GPay / PhonePe / Paytm / netbanking) ----
# Leave blank to run the built-in DEMO gateway (the checkout flow completes and
# records a paid order without moving real money — great for local testing).
# Add your TEST keys from https://dashboard.razorpay.com to run real Razorpay
# Checkout in test mode; swap in LIVE keys after KYC to take real payments.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Currency for charges (Razorpay uses the smallest unit, i.e. paise for INR).
CURRENCY=INR
